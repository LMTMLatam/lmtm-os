@@ -230,7 +230,12 @@ function parseHermesOutput(stdout, stderr) {
         const errorLines = stderr
             .split("\n")
             .filter((line) => /error|exception|traceback|failed/i.test(line))
-            .filter((line) => !/INFO|DEBUG|warn/i.test(line)); // skip log-level noise
+            .filter((line) => !/INFO|DEBUG|warn/i.test(line)) // skip log-level noise
+            // Python asyncio teardown noise: hermes prints "Exception ignored in:
+            // <coroutine object MCPServerTask.run> ... Event loop is closed" on
+            // clean exit (code 0). It is NOT a run failure — without this filter
+            // every successful run gets misclassified as failed and retried.
+            .filter((line) => !/Exception ignored|Event loop is closed|coroutine object|^\s*(File |raise )|^\s*Traceback \(most recent call last\)/.test(line));
         if (errorLines.length > 0) {
             result.errorMessage = errorLines.slice(0, 5).join("\n");
         }
